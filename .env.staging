# Staging Environment
# Values injected via GitHub Actions secrets / environment variables at runtime

# LLM Provider Configuration
LLM_PROVIDER=${{ secrets.LLM_PROVIDER }}
LLM_API_KEY=${{ secrets.LLM_API_KEY }}

# Database
DATABASE_URL=${{ secrets.DATABASE_URL }}
POSTGRES_USER=${{ secrets.POSTGRES_USER }}
POSTGRES_PASSWORD=${{ secrets.POSTGRES_PASSWORD }}
POSTGRES_DB=${{ secrets.POSTGRES_DB }}

# Redis
REDIS_URL=${{ secrets.REDIS_URL }}

# JWT
JWT_SECRET_KEY=${{ secrets.JWT_SECRET_KEY }}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=${{ secrets.NEXT_PUBLIC_API_URL }}
NEXT_PUBLIC_APP_URL=${{ secrets.NEXT_PUBLIC_APP_URL }}

# Voice (STT/TTS) - Phase 6
WHISPER_API_KEY=${{ secrets.WHISPER_API_KEY }}
ELEVENLABS_API_KEY=${{ secrets.ELEVENLABS_API_KEY }}

# ABDM/FHIR Integration - Phase 4+
ABDM_CLIENT_ID=${{ secrets.ABDM_CLIENT_ID }}
ABDM_CLIENT_SECRET=${{ secrets.ABDM_CLIENT_SECRET }}
FHIR_BASE_URL=${{ secrets.FHIR_BASE_URL }}

# Monitoring/Observability
SENTRY_DSN=${{ secrets.SENTRY_DSN }}
LOG_LEVEL=INFO