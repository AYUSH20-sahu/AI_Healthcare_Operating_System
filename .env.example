# ==============================================================================
# AI-HOS — Complete Environment Configuration Reference
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO


# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────
# Nhost / Supabase / local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_hos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ai_hos


# ──────────────────────────────────────────────────────────────────────────────
# REDIS (optional — persistent JWT revocation)
# Without Redis: logout only works in-memory (tokens survive server restart)
# Install: sudo apt install redis-server  OR  docker run -p 6379:6379 redis:alpine
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ──────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_64_char_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SUPER_ADMIN_EMAIL=admin@yourhospital.com


# ──────────────────────────────────────────────────────────────────────────────
# AI / LLM PROVIDERS
# The system uses: NVIDIA NIM → Gemini → Mock (fallback chain)
# Without any key: MockLLMProvider returns deterministic SOAP notes for dev/testing
# ──────────────────────────────────────────────────────────────────────────────

# Primary LLM: NVIDIA NIM
# Get key: https://build.nvidia.com/ → "Get API Key"
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
LLM_API_KEY=nvapi-your_nvidia_nim_api_key_here   # same as NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Fallback LLM: Google Gemini
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here


# ──────────────────────────────────────────────────────────────────────────────
# VOICE / SPEECH PROVIDERS
# ──────────────────────────────────────────────────────────────────────────────

# STT (Speech-to-Text): Groq Whisper — fast, affordable, highly accurate
# Get key: https://console.groq.com → API Keys
# Without key: MockSTTProvider returns a sample chest-pain transcript for testing
STT_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# TTS (Text-to-Speech): ElevenLabs — natural clinical voice responses
# Get key: https://elevenlabs.io → Profile → API Key
# Without key: MockTTSProvider returns silent audio (no crash)
TTS_PROVIDER=mock          # Change to "elevenlabs" when key is added
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Legacy Whisper (OpenAI) — optional alternative to Groq
WHISPER_API_KEY=your_whisper_api_key_here


# ──────────────────────────────────────────────────────────────────────────────
# SMTP / EMAIL DELIVERY
# Used for: medicine reminders, appointment reminders
# Set SMTP_ENABLED=true and fill credentials to enable actual email sending.
# Without config: emails are logged only (never actually sent — no crash)
# ──────────────────────────────────────────────────────────────────────────────
SMTP_ENABLED=false           # Set to true when credentials are filled

# Gmail example (use App Password if 2FA is on):
#   https://myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@yourhospital.com

# SendGrid alternative:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key


# ──────────────────────────────────────────────────────────────────────────────
# ABDM / ABHA Integration (Ayushman Bharat Digital Mission)
# Sandbox mode works without credentials — use test OTP 123456
# For production: apply at https://sandbox.abdm.gov.in/
# ──────────────────────────────────────────────────────────────────────────────
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_SANDBOX_MODE=true       # Set false only with real ABDM credentials
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Health Facility Registry
HFR_FACILITY_ID=IN-DL-AIHOS-001
HFR_FACILITY_NAME=AI-HOS Apex Clinical Center


# ──────────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ──────────────────────────────────────────────────────────────────────────────

# Sentry error tracking (https://sentry.io → Projects → DSN)
# Without key: Sentry is completely disabled (no crash)
SENTRY_DSN=your_sentry_dsn_here   # e.g. https://xxx@yyy.ingest.sentry.io/zzz


# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND (Next.js)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000